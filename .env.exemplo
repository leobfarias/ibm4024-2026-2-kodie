# ============================================================
# Modelo de configuracao de producao.
#
# Copie este arquivo para ".env" (sem o ".exemplo") e preencha.
# O ".env" esta no .gitignore: as senhas nunca vao para o GitHub.
# ============================================================

SPRING_PROFILES_ACTIVE=prod

# Formato JDBC obrigatorio, com SSL:
#   jdbc:postgresql://SERVIDOR:5432/BANCO?sslmode=require
#
# O provedor costuma entregar a conexao assim:
#   postgresql://USUARIO:SENHA@SERVIDOR/BANCO?sslmode=require
# Para converter: troque "postgresql://" por "jdbc:postgresql://",
# tire o trecho "USUARIO:SENHA@" e coloque usuario e senha abaixo.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Senha do administrador criado na primeira subida (minimo 8 caracteres).
KODIE_ADMIN_SENHA=
